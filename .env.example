OPENAI_API_KEY=sk-...

DATABASE_URL=postgresql://postgres:password@localhost:5432/youthlink
RAG_BASE_URL=http://localhost:8000

# 데이터셋 생성 및 채점 LLM. RAG 모델(luna 계열)과 다른 모델 (자기 답변 채점 편향 방지)
GEN_MODEL=gpt-5.5        # 1회성 생성, 질문·정답 품질 우선
JUDGE_MODEL=gpt-5.5      # 반복 채점, 비용을 줄이려면 gpt-5.4-mini

# 임베딩 모델 ETL 서버와 통일
EMBEDDING_MODEL=text-embedding-3-small
# run --baseline 전용. RAG 서버와 통일
BASELINE_MODEL=gpt-5.6-luna   # 설치된 OpenAI SDK 기준 luna 모델. RAG 담당자와 최종 확정 필요
