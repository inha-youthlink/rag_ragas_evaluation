OPENAI_API_KEY=sk-...

DATABASE_URL=postgresql://postgres:password@localhost:5432/youthlink
RAG_BASE_URL=http://localhost:8000

# 데이터셋 생성 및 채점 LLM
GEN_MODEL=
JUDGE_MODEL=

# ===== 선택 (비워 두면 기본값) =====

# 채점(Answer Relevancy)·생성기용 임베딩. RAG 검색 임베딩(ETL과 같은 값)과는 별개
EMBEDDING_MODEL=         # 기본값: text-embedding-3-small
# run --baseline 전용. RAG CHAT_MODEL과 같은 모델 (공정 비교)
BASELINE_MODEL=          # 예: gpt-6-luna
# baseline·채점 OpenAI 호출. RAG 기본값과 맞춤
OPENAI_TIMEOUT=          # 기본값: 30.0
OPENAI_MAX_RETRIES=      # 기본값: 2
